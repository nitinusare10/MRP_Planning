# Copy this file to .env (local dev) and fill in real values.
# Never commit .env — it is gitignored. This file documents what's required only.

# ── Database ────────────────────────────────────────────────────────────
# PostgreSQL connection string. In production this points at the managed
# Postgres instance (see docs/architecture.md "Deployment Architecture").
DATABASE_URL="postgresql://user:password@localhost:5432/dopar_mrp_dev?schema=public"

# ── Authentication (Auth.js) ────────────────────────────────────────────
# Random 32+ byte secret used to sign session JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"

# Canonical URL of this deployment. Required in production; Auth.js infers
# it from the request in local dev if omitted.
# AUTH_URL="https://mrp.doparenergy.com"

# ── Development seed (prisma/seed.ts) ────────────────────────────────────
# Creates exactly one ADMIN user for local login. Required to run `npm run db:seed`.
# SEED_ADMIN_EMAIL="admin@doparenergy.com"
# SEED_ADMIN_PASSWORD="choose-a-strong-local-password"
# SEED_ADMIN_NAME="Dopar MRP Admin"

# ── Logging ──────────────────────────────────────────────────────────────
# One of: fatal, error, warn, info, debug, trace. Defaults to "info".
LOG_LEVEL="info"

# ── Zoho Inventory integration (Phase 1) ─────────────────────────────────
# The integration code (OAuth flow, API client, sync jobs) is fully built and
# tested against mocked Zoho responses, but no real Zoho app is registered
# yet. Leave ZOHO_CLIENT_ID/SECRET/REDIRECT_URI/DATA_CENTER unset until you
# have one — "Connect to Zoho" on /zoho will show a clear "not configured"
# message rather than failing unpredictably. See
# docs/architecture.md "Zoho Integration Architecture" for how to register a
# Zoho API console app and what OAuth scope/redirect URI it needs.

# From the Zoho API Console (https://api-console.zoho.<data-center>) app you register:
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the Zoho app, and must
# point at this deployment's /api/zoho/oauth/callback route.
# ZOHO_REDIRECT_URI="http://localhost:3000/api/zoho/oauth/callback"
# Which Zoho data center your account is on: com, in, eu, au, jp, or ca.
# Confirm this with Dopar Energy's Zoho account owner before connecting.
# ZOHO_DATA_CENTER="in"

# Encrypts ZohoConnection's stored access/refresh tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# This one IS needed even before you have real Zoho credentials, since the
# encryption code path is exercised by the test suite.
ZOHO_ENCRYPTION_KEY="replace-with-a-strong-random-32-byte-base64-key"
